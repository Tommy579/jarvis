# === Fournisseurs LLM ===
# Au moins une cle est necessaire ; sinon le service demarre en mode hors-ligne (repli local).
OPENROUTER_API_KEY=votre_cle_openrouter_ici
GEMINI_API_KEY=votre_cle_gemini_ici
# Optionnel : utiliser Google Vertex AI via OAuth (gcloud auth application-default login).
# Sans GOOGLE_CLOUD_PROJECT, Vertex est ignore et le mode hors-ligne s'applique.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Serveur Ollama local (http://127.0.0.1:11434/v1). Laisse vide pour le desactiver.
OLLAMA_BASE_URL=

# === Service central jarvis-core ===
# Jeton attendu en en-tete Authorization: Bearer <jeton> (ou ?token=...).
# Laisse vide : scripts/launch_jarvis_v2.sh genere un jeton aleatoire au premier lancement.
# En Docker ou systemd, renseigne-le toi-meme :
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Ne mets jamais une valeur d'exemple : ce fichier est public, son contenu aussi.
JARVIS_API_TOKEN=
# Deverrouille un usage local sans jeton (loopback uniquement). A ne jamais mettre a 1
# sur une machine exposee : le service refuserait sinon de demarrer sans jeton.
JARVIS_ALLOW_INSECURE=0
JARVIS_DATA_DIR=~/jarvis-data
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765
# Secret HMAC des liens d'approbation envoyes par notification (SMS/ntfy/Telegram).
PUBLIC_WEBHOOK_BASE_URL=

JARVIS_PERSONA=developer
JARVIS_OBJECTIVE=L'utilisateur est developpeur. Propose des reponses concises et utiles.

# === Voix (TTS Gemini) ===
# gemini-3.8-flash-lite-tts par defaut, voix Charon si non renseigne.
GEMINI_TTS_MODEL=
GEMINI_TTS_VOICE=
# Code PIN demande pour valider une action sensible a la voix.
JARVIS_VOICE_PIN=

# === Controle navigateur (CDP) ===
# Chrome/Chromium doit exposer un port de debogage : chromium --remote-debugging-port=9222
JARVIS_CDP_URL=http://127.0.0.1:9222
# Modele utilise par browser_analyze_media (necessite GEMINI_API_KEY)
JARVIS_MEDIA_MODEL=gemini-4-carbon

# === Canal Telegram ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
# Secret HMAC des liens d'approbation mobiles. Vide = secret ephemere genere a chaque
# demarrage (liens invalides apres redemarrage). Valeur fixe : generer comme ci-dessus.
ACTION_TOKEN_SECRET=

# === Recherche web et transports ===
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
# Horaires SNCF / trajets (connecteur weather_transport).
NAVITIA_API_KEY=

# === Integrations externes ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_ACCESS_TOKEN=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Flux iCal Apple Calendar (URL privee exportee depuis l'app Calendrier).
APPLE_CALENDAR_ICS_URL=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_OAUTH_ACCESS_TOKEN=
MICROSOFT_OAUTH_REFRESH_TOKEN=
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
GITHUB_WEBHOOK_SECRET=
NOTION_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_ACCESS_TOKEN=
# Webhook du bot de trading (POST /api/webhooks/trading).
TRADER_WEBHOOK_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TO_EMAIL=
