[Unit]
Description=OMI 2.0 Core Service (FastAPI, Agent, Memoire, Attention)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/omi
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/omi/packages/shared:/opt/omi/packages/core:/opt/omi/packages/desktop
ExecStart=/opt/omi/.venv/bin/uvicorn omi_core.api.server:app --host 127.0.0.1 --port 8765
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
